# ============================================================
# 阿里云短信认证 · 环境变量模板（lesson-39）
#
# 用法：把这些行追加到服务器 /etc/teacherbank/app.env（chmod 600），
#       填完 systemctl restart teacherbank-api 即生效。
#
# ⚠️ 密钥不写进仓库、不写进脚本 —— 只由老大在服务器上手填。
# ============================================================

# --- 必填：控制台「赠送签名」和「赠送模板」的名字/编号 ---
#    号码认证控制台 → 短信认证 → 赠送签名配置 / 赠送模板配置
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# --- 可选：静态 AccessKey（不给实例 RAM 角色时才需要填）---
#    推荐用 ECS 实例 RAM 角色：服务器上完全不存密钥。
#    走角色时这两行留空即可，后端会自动取 STS 临时凭据。
#    如果要用静态 AK，就建 RAM 子账号，只授这两个 action：
#      dypns:SendSmsVerifyCode + dypns:CheckSmsVerifyCode
#ALIYUN_SMS_ACCESS_KEY_ID=
#ALIYUN_SMS_ACCESS_KEY_SECRET=

# --- 可选：模板参数（留空 = 用默认 {"code":"##code##","min":"5"}）---
#    ##code## 表示验证码由阿里云生成并保管（我们不存明文）
# ALIYUN_SMS_TEMPLATE_PARAM=

# --- 可选：端点与方案名（一般不用改）---
# ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
# ALIYUN_SMS_SCHEME_NAME=

# --- 可选：注册通道总开关 ---
#    填 false = 一键关闭注册（发码与注册都返回 403）
#    邀请码时代的闸被短信注册拆掉了，留这个当保险
# REGISTRATION_ENABLED=true
