<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  教师题库 · 本地备份拉回（每天 04:00）
  装到: ~/Library/LaunchAgents/com.teacherbank.backup.plist
  加载: launchctl load -w ~/Library/LaunchAgents/com.teacherbank.backup.plist

  StartCalendarInterval + RunAtLoad=false
  → 每天 04:00 跑一次；机器关机错过了，下次开机 launchd 会补跑（比 cron 靠谱）
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.teacherbank.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/rrobot/teacher-bank-backup/pull-backup.sh</string>
    </array>

    <!-- 每天 04:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 不在开机时立刻跑（避免刚开机网络还没起来就失败） -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/rrobot/teacher-bank-backup/pull.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rrobot/teacher-bank-backup/pull.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>REMOTE_HOST</key>
        <string>ecs</string>
    </dict>
</dict>
</plist>
