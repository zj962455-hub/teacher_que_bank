# PaddleOCR API 环境变量模板
# 实际位置:/etc/paddleocr/api.env(chmod 600)
# 装好后修改:systemctl restart paddleocr-api

# 多个 key 用逗号分隔,任一有效即放行
# 建议至少两个:本地调试用 + 服务调用用,可独立吊销
OCR_API_KEYS=local_dev_key_here,service_call_key_here

# 图片大小上限(MB)
OCR_MAX_IMAGE_MB=10

# 模型选择:PP-StructureV3(版面+公式+表格)/ PP-OCRv5(纯文本)/ PaddleOCR-VL(综合最强)
OCR_MODEL=PP-StructureV3

# 语言:ch / en / chinese_cht / japan / korean
OCR_LANG=ch